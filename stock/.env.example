PORT=5174

# FinMind API token — https://finmindtrade.com/analysis/#/account/login
FINMIND_TOKEN=

# 快取 TTL（毫秒）。歷史資料預設 1 天，盤中即時資料預設 5 秒。
CACHE_TTL_HISTORICAL_MS=86400000
CACHE_TTL_REALTIME_MS=5000

# Supabase 連線（自我學習回饋資料持久化用）
# Dashboard → Settings → API
#   URL：Project URL
#   KEY：service_role secret（推薦，無 RLS 限制）；anon key 也可但要設 RLS policy
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 啟動時是否預熱權值股快取（解 cold start 慢）— 預設開，設 0 關閉
WARM_CACHE=1

# 排程觸發保護密鑰（POST /api/cron/daily-backfill 需要）
# 給外部 cron service（cron-jobs.org / GitHub Actions / Railway cron）打 webhook 用
# 沒設 = 不檢查（dev 方便）；正式環境一定要設
CRON_SECRET=
